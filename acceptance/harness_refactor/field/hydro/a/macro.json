    "record": {
      "kind": "run_input",
      "media_type": null
    },
    "upstream_original": {
      "kind": "run_input",
      "media_type": null
    }
  },
  "kind": "recipe",
  "macro": {
    "decision_point": {
      "event": "join_outcome",
      "inspect": [
        "audit",
        "volume",
        "computed"
      ],
      "question": "After both reviews and the paired computation, do the verified IDs, units and whole common dates warrant an ordering for the new records? For positive common duration, publish left greater if the lower bound is positive or right greater if the upper bound is negative. If zero falls in the interval, report the nominal difference and uncertainty in its sign. Withhold the ordering if source alignment or common coverage is unresolved.",
      "role": "run_lead"
    },
