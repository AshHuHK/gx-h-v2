  "decisions": [
    {
      "decision_ref": "gxa_c1b9690e49e74f1b9c29a4ff95a317fbf7706928077f0de18b45078cf78795f7",
      "turn_id": "01a21edb-0989-75d3-b583-1be53e1a24d4",
      "rationale": "The sequence and connectivity tables assign the terminal amide its own polymer position in 1LE0. Matched measurements of the two deposits will quantify the effect on backbone coverage. The independent inventory checks coverage in the other NMR models.",
      "evidence_refs": [
        "gxa_01m8fdp0n8eksfb7rp",
        "gxa_01m8fdp0nxgc0q2m3c"
      ],
      "ops": [
        "open_branch",
        "add_node",
        "add_node"
      ],
      "outcome": "adopted"
    },
    {
      "decision_ref": "gxa_841a9702ee3a559f18d18f9ba3b21a47e980075a851743fb5c9d11fb88c36080",
      "turn_id": "01a21edc-f60d-7412-80b8-a1debdb61104",
      "rationale": "The original coordinate tables show a positive-occupancy heavy atom at every declared chain A site and N, CA, C and O at every amino acid in each deposited model. Chignolin assigns OXT to its final glycine. The tryptophan zipper assigns its terminal amide a separate position and records a covalent link to the terminal lysine’s carbonyl carbon. The two commissioned measurements will supply the formal model-1 counts, and the independent inventory will cross-check the ensemble result. Await those reports before closing the run.",
      "evidence_refs": [
        "gxa_01m8fdp0n8eksfb7rp",
        "gxa_01m8fdp0nxgc0q2m3c"
      ],
      "ops": [],
      "outcome": "maintained"
    },
    {
      "decision_ref": "gxa_20b8ae07fe1dc9af4f1deef91d26ccf38bc247a83cfa350b2b897ae8baaad1fe",
      "turn_id": "01a21ede-f081-7073-a091-b3f63efd578e",
      "rationale": "The measured fractions agree with a direct count of the original atom sites in every deposited model. Each declared position has a positive-occupancy heavy atom, and every amino acid has N, CA, C and O. Chignolin assigns its terminal oxygen to glycine. The tryptophan zipper gives its terminal amide a separate position and explicitly bonds its nitrogen to the terminal lysine carbonyl. Publish the two archive findings and await the commissioned independent inventory of the original annotations before final closure. Repeating the coordinate measurements would add no new observation.",
      "evidence_refs": [
        "gxa_01m8fdp0n8eksfb7rp",
        "gxa_01m8fdp0nxgc0q2m3c",
        "gxa_01m8fdsxqfrs678s88",
        "gxa_01m8fdsxx3sh6c94sq",
        "gxa_01m8fe26wvd1y5ke6n",
        "gxa_01m8fe29ys4d3n7jcc"
      ],
      "ops": [],
      "outcome": "maintained"
    },
    {
      "decision_ref": "gxa_a75f630d331c9e80eb87f1faa9951b1aa4aa8fa8ce5e411a8db0a0d1c1a41476",
      "turn_id": "01a21ee1-9db3-7552-9e21-aa8f96a1a29c",
      "rationale": "The completed inventory checked the original sequence, chemistry, linkage and atom-site records and agrees with the coverage tables model by model. Chignolin assigns OXT to the final glycine. The tryptophan zipper numbers the terminal NH2 separately, includes coordinates for its nitrogen and bonds that nitrogen to the last lysine carbonyl. Those records account for both denominators. The two readings of each file agree, and further counts of those files would add no independent information about the sample.",
      "evidence_refs": [
        "gxa_01m8fdp0n8eksfb7rp",
        "gxa_01m8fdp0nxgc0q2m3c",
        "gxa_01m8fdsxqfrs678s88",
        "gxa_01m8fdsxx3sh6c94sq",
        "gxa_4263c8dbcfb53c12f075557bc562c7f1eb412098d555bbe5cce4e5ae99a08b89"
      ],
