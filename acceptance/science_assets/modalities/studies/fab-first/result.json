    {
      "hypothesis_id": "gxh_01m8fe2zxy5vmfnkx4",
      "statement": "matched_positions = 50; mapped_positions = 50.",
      "scope": "The annotated isolated Fab assembly and its paired heavy- and light-chain IMGT CDRs in the first deposited model.",
      "criteria": "For a Cα trace comparison, require concordant chain assignments and an observed Cα at each included IMGT site in the first model. To extend this to a complete-backbone comparison, require positive-occupancy N, CA, C and O at each included site.",
