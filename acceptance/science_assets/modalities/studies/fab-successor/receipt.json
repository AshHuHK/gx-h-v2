  "decisions": [
    {
      "decision_ref": "gxa_70eadeb8795bd1a0799fb9941fa5a2493c02762ee79dc8e4f8ca73dcee38458c",
      "turn_id": "01a21ee1-9337-7461-b607-7d55731f15b7",
      "rationale": "Run the archived paired-Fab procedure on the 1MCP originals to test complete Cα coverage. Comparing matched and assigned counts within each IMGT CDR will show which loops can enter a comparison across their shared sites.",
      "evidence_refs": [
        "gxa_01m8fe32t22ec6dfjs",
