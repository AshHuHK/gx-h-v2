      "outcome": "adopted"
    },
    {
      "decision_ref": "gxa_3851d582da520d381a8720329c5a177862879dbf438b17c619f0760a2cc09346",
      "turn_id": "01a21ee3-921a-7881-a110-9f9c1be88608",
      "rationale": "The 1MCP annotation assigns 8, 10 and 13 IMGT positions to VH CDR1–3 and 12, 3 and 9 to VL CDR1–3. The commissioned job applies the archived paired-Fab procedure to this annotation and its source structure. Await its per-loop matched counts to identify any loop that requires a residue-level mask before comparison.",
      "evidence_refs": [
        "gxa_01m8fe32t22ec6dfjs",
        "gxa_01m8fe32sf8v42h2fd",
        "gxa_01m8fe569zmc91serr"
      ],
      "ops": [],
      "outcome": "maintained"
    },
    {
      "decision_ref": "gxa_565110d2df016a7921790d648c6c5f939fe8c796752728628e06ad0bef813001",
      "turn_id": "01a21ee4-2149-74c0-a5ae-36849454854f",
      "rationale": "The archived paired-fab-imgt-ca-coverage@1 procedure validated the supplied ANARCI IMGT map against 1MCP assembly 1 and counted positive-occupancy Cα sites in model 1. The map assigns 8, 10 and 13 positions to CDR1–3 of heavy label chain B and 12, 3 and 9 to CDR1–3 of κ light label chain A. In fab_coverage.json the matched count equals the assigned count within each of those loops, giving {{metric:matched_positions}} observed Cα sites among {{metric:mapped_positions}} assignments. Retain every loop and compare positions that share a domain, IMGT number and insertion label and have a Cα in both deposits. Repeating the same procedure would add no information about other backbone atoms.",
      "evidence_refs": [
        "gxa_01m8fe74x1xfrgk7r1",
        "gxa_01m8fe32t22ec6dfjs",
        "gxa_01m8fe32sf8v42h2fd"
      ],
      "ops": [
        "close_run"
      ],
      "outcome": "adopted"
    }
