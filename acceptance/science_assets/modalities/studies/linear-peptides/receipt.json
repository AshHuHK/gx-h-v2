  "decisions": [
    {
      "decision_ref": "gxa_69367a6629346bb9b8097a785942b4500f62c6e89aa8f75b8c249fdcc1f30da5",
      "turn_id": "01a21ed8-966c-7c51-ab33-6c66c95761ac",
      "rationale": "Count represented heavy-atom positions and amino-acid backbones by the same criteria on both originals. The amide and terminal glycine in the sequence declarations supply a direct check on the denominator.",
      "evidence_refs": [
        "gxa_01m8fdh3z8bjvphgrx",
        "gxa_01m8fdh3zv03ry2khn",
        "gxa_01m8fdkshzfg2avvpr"
      ],
      "ops": [
        "open_branch",
        "add_node",
        "add_node"
      ],
      "outcome": "adopted"
    },
    {
      "decision_ref": "gxa_f539d8f008e7f72a107ff8a7a6c6b0a3b016c245ebd1980007ce87ace3e9d260",
      "turn_id": "01a21edb-8af3-7ef1-8130-41caafb2264a",
      "rationale": "Measure the amino-acid denominator and modification annotations for each deposit with the archival peptide method. The inventory report returned no findings, and the backbone jobs count atom sites without reporting the annotation-defined denominator. Chignolin assigns OXT to its terminal glycine. The tryptophan zipper assigns its amide a sequence position and records a covalent link from the lysine carbonyl to the amide nitrogen. The positive-occupancy atom sites show the same position and backbone coverage pattern in every model of each deposit. The registered comparisons test how the archival method classifies those terminal groups.",
      "evidence_refs": [
        "gxa_01m8fdh3z8bjvphgrx",
        "gxa_01m8fdh3zv03ry2khn",
        "gxa_f71078e0abfd56f36d280415be366662c74c2dfad199438c2331e53bfb9cdd90",
        "gxa_01m8fdshz4y6svq77y",
        "gxa_01m8fdsxkgcgc44prw"
      ],
      "ops": [
        "open_branch",
        "add_node",
        "add_node"
      ],
      "outcome": "adopted"
    },
    {
      "decision_ref": "gxa_b5d1ede716f0b49e0ffec12efce331b346150a691b29529298707e1271ec6659",
      "turn_id": "01a21ede-6904-7d41-b4d5-13100e608117",
      "rationale": "Retain the two commissioned archival analyses to check the annotation-based peptide denominators and modification records. Chignolin has {{metric:gxa_01m8fdq2wey63eg0yb:coordinate_coverage}} declared-position coverage and {{metric:gxa_01m8fdq2wey63eg0yb:complete_backbones}} complete backbones. The tryptophan zipper has {{metric:gxa_01m8fdq32t6jhzctx9:coordinate_coverage}} declared-position coverage and {{metric:gxa_01m8fdq32t6jhzctx9:complete_backbones}} complete backbones. The original atom records assign OXT to chignolin’s terminal glycine and represent the zipper’s separately numbered terminal amide by its nitrogen. The zipper’s connectivity record links that nitrogen to the lysine carbonyl. The inventory report supplied no interpretation. Repeating the coordinate measurements on these files would add no independent evidence.",
      "evidence_refs": [
        "gxa_01m8fe0naa8kg02xws",
        "gxa_01m8fdq2wey63eg0yb",
        "gxa_01m8fdq32t6jhzctx9",
        "gxa_01m8fdh3z8bjvphgrx",
        "gxa_01m8fdh3zv03ry2khn",
        "gxa_f71078e0abfd56f36d280415be366662c74c2dfad199438c2331e53bfb9cdd90"
      ],
      "ops": [],
      "outcome": "maintained"
    },
    {
      "decision_ref": "gxa_3af0bd478bc55920cad7c4148b9a2bafea62862ab0bf7039b4b754cf4d30df37",
      "turn_id": "01a21ee0-9e96-7642-9f64-3b5b67e58858",
      "rationale": "Use declared peptide-linking residues as the denominator for backbone coverage. Chignolin has {{metric:gxa_01m8fdwtbtyyh52fjg:backbone_positions}}/{{metric:gxa_01m8fdwtbtyyh52fjg:peptide_residue_positions}} complete backbones and {{metric:gxa_01m8fdwtbtyyh52fjg:observed_positions}}/{{metric:gxa_01m8fdwtbtyyh52fjg:declared_positions}} represented components. The tryptophan zipper has {{metric:gxa_01m8fdwthqq2wk3h8d:backbone_positions}}/{{metric:gxa_01m8fdwthqq2wk3h8d:peptide_residue_positions}} complete backbones and {{metric:gxa_01m8fdwthqq2wk3h8d:observed_positions}}/{{metric:gxa_01m8fdwthqq2wk3h8d:declared_positions}} represented components. The first-model Cα counts are {{metric:gxa_01m8fdq2wey63eg0yb:ca_count}} and {{metric:gxa_01m8fdq32t6jhzctx9:ca_count}}, respectively. The per-model listings preserve the coverage across {{metric:gxa_01m8fdwtbtyyh52fjg:model_count}} chignolin models and {{metric:gxa_01m8fdwthqq2wk3h8d:model_count}} zipper models. Chignolin assigns OXT to its terminal glycine. The zipper assigns its terminal amide a separate position and records a covalent bond from the lysine carbonyl carbon to the cap nitrogen. The modification category is absent in each file. Both analyses use the same coordinates, and the partial inventory contributes no independent measurement.",
      "evidence_refs": [
        "gxa_01m8fdwtbtyyh52fjg",
        "gxa_01m8fdwthqq2wk3h8d",
        "gxa_01m8fdq2wey63eg0yb",
        "gxa_01m8fdq32t6jhzctx9",
        "gxa_01m8fdh3z8bjvphgrx",
        "gxa_01m8fdh3zv03ry2khn",
        "gxa_f71078e0abfd56f36d280415be366662c74c2dfad199438c2331e53bfb9cdd90"
      ],
      "ops": [
        "close_run"
      ],
      "outcome": "adopted"
    }
  ],
