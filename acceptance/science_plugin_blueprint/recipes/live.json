      },
      {
        "decision_ref": "gxa_a41ece3b925ca8c7ad03dd687460cb129d32c6e4bb139463afe742e4a533dfd5",
        "turn_id": "01a21e64-91e3-7cf1-b139-fa6a03fac3ce",
        "rationale": "The execution record links the supplied Top7 specimen to the fresh AlphaFold 3 coordinates. The mapping and independent inventory agree that specimen A1–A92 corresponds to 1QYS A3–A94, including Met35 paired with the observed Cα of selenomethionine A37. A single CPU fit using those explicit pairs will measure coverage in both structures and the geometric discrepancy over the usable pairs.",
        "evidence_refs": [
          "gxa_01m8f6940tr4n0gqdm",
          "gxa_01m8f6941kdabdfg44",
          "gxa_01m8f5r5b23h6pajqz",
          "gxa_01m8f5r5bq6f0gcxjb",
