      },
      {
        "decision_ref": "gxa_8f64fedb4f8db8825ba6c470edb2f7c51d3bc8d905849a4439adc1cfbe61fa00",
        "turn_id": "01a21e62-d2bc-7c82-85ae-9912f3c87b58",
        "rationale": "I verified a unique, full-occupancy model 1 Cα at every mapped reference site in 1QYS. The supplied map pairs specimen A1–A92 with reference A3–A94, including Met35 with selenomethionine A37. This confirms the independent inventory and preserves all 92 intended pairs for the fit. The existing AlphaFold 3 job holds the GPU reservation and still requires operator approval. Once it delivers model.cif, the registered proper-rotation fit can determine paired coverage and Cα RMSD. Until then the discrepancy is unknown.",
        "evidence_refs": [
          "gxa_01m8f5r5b23h6pajqz",
          "gxa_01m8f5r5cc1pd82j1a",
          "gxa_01m8f5r5bq6f0gcxjb",
          "gxa_5d8b8bb97863a8870bfb4705b8be040b90fccefad758861b1e5873d7a4c80aae"
        ],
