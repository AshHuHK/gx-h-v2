#!/usr/bin/env python3
"""Run GX P0 from this package using the configured Clash endpoints."""

import os
from pathlib import Path
import sys


sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "gx-h"))

from gx_core.p0.profiles import proxy_settings

os.environ.update(proxy_settings())

from gx_core.p0.cli import main

raise SystemExit(main())
