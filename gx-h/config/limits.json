  "network": {
    "all_outbound_via_clash": true,
    "http_proxy": "http://127.0.0.1:7890",
    "socks5_proxy": "socks5h://127.0.0.1:7891",
    "bypass_allowed": [
      "localhost",
      "127.0.0.1",
      "::1"
    ],
    "forbidden": [
      "curl --noproxy",
      "unsetting proxy variables",
      "widening NO_PROXY",
      "direct-connection fallback"
    ]
  },
  "approval_required_actions": [
    "real high-cost GPU or HPC jobs beyond the gpu budget above",
    "new model weight or large database downloads",
    "deletion or irreversible migration",
    "restarting any shared service",
    "modifying global client configuration",
    "exposing a network port",
    "sending private data to any external service",
    "any new paid service",
    "widening the data scope",
    "production plugin or evaluator updates"
  ],
  "host_pool": {
    "max_slots": 13,
    "slot_counting": "total_including_root_and_external_occupied",
    "max_agent_depth": 4,
    "root_depth": 0,
    "target_concurrent_children": 10
  },
  "screens": {
    "credentials": [
      {
        "id": "private_key_block",
        "pattern": "-----BEGIN [A-Z ]{0,30}PRIVATE KEY-----",
        "why": "a private key"
      },
      {
        "id": "api_key_sk",
        "pattern": "\\bsk-[A-Za-z0-9_-]{20,200}",
        "why": "an API key"
      },
      {
        "id": "github_token",
        "pattern": "\\bgh[pousr]_[A-Za-z0-9]{20,255}",
        "why": "a GitHub token"
      },
      {
        "id": "aws_access_key",
        "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
        "why": "an AWS access key id"
      },
      {
        "id": "slack_token",
        "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,200}",
        "why": "a Slack token"
      },
      {
        "id": "jwt",
        "pattern": "\\beyJ[A-Za-z0-9_-]{20,2000}\\.[A-Za-z0-9_-]{20,4000}\\.[A-Za-z0-9_-]{10,1000}",
        "why": "a signed token"
      },
      {
        "id": "bearer_header",
        "pattern": "(?i)\\bbearer[ \\t]{1,8}[A-Za-z0-9._-]{20,2000}",
        "why": "an authorization header"
      }
    ]
  }
}
