    "max_self_memory_mib": 8192,
    "max_concurrent_gpu_jobs": 1,
    "max_wall_minutes": 20,
    "queue_wait_seconds": 1800,
    "queue_wait_seconds_note": "How long a GPU job may wait in the device's queue before it ends FAILED not_started (design r2.2a §7.1). Such a job is charged nothing; the wait counts against run_budget.resource_waits_per_path. A limits line since contract r5 so that a test can lower it in a relocated copy.",
    "abort_if_preflight_missing": true,
    "record_preflight_in_job": true
  },
  "engineering_budget": {
    "max_repair_attempts_per_fingerprint": 3,
    "max_global_repair_rounds_per_session": 6,
    "stop_after_no_new_evidence_rounds": 2,
    "metadata_command_timeout_seconds": 60,
    "ordinary_test_timeout_seconds": 300,
    "project_qualification_retry_timeout_seconds": 1200,
    "reviewed_install_timeout_seconds": 900
