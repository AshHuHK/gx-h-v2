{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GX Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "api_version", "kind", "entrypoint", "gx_compat", "dependencies", "extensions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+\\.)*[0-9A-Za-z-]+)?(\\+([0-9A-Za-z-]+\\.)*[0-9A-Za-z-]+)?$"},
    "api_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "kind": {"type": "string", "enum": ["builtin", "workflow", "tool_provider", "evaluator", "bundle"]},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"},
    "gx_compat": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "optional": {"type": "boolean"}}
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "contract", "version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "enum": ["workflow", "tool", "capability", "evaluator", "goal_method", "goal_tool"]},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "description": {"type": "string"}, "author": {"type": "string"}, "license": {"type": "string"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
