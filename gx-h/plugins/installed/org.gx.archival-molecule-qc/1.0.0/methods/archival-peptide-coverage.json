              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          },
          "observed_positions": {
            "reader": "json/1",
            "op": "integer/1",
            "pointer": "/observed_positions",
            "unit": "1",
            "places": 0,
            "scope": {
              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          },
          "backbone_positions": {
            "reader": "json/1",
            "op": "integer/1",
            "pointer": "/backbone_positions",
            "unit": "1",
            "places": 0,
            "scope": {
              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          },
          "model_count": {
            "reader": "json/1",
            "op": "integer/1",
            "pointer": "/model_count",
            "unit": "1",
            "places": 0,
            "scope": {
              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          },
          "peptide_residue_positions": {
            "reader": "json/1",
            "op": "integer/1",
            "pointer": "/peptide_residue_positions",
            "unit": "1",
            "places": 0,
            "scope": {
              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          },
          "declared_modified_positions": {
            "reader": "json/1",
            "op": "integer/1",
            "pointer": "/declared_modified_positions",
            "unit": "1",
            "places": 0,
            "scope": {
              "entry": "/entry",
              "input_sha256": "/input_sha256"
            }
          }
        }
