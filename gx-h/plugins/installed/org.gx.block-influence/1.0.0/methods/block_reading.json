          }
        }
      }
    ],
    "limitations": "Descriptive sensitivity on common observed positions only. Fits with insufficient data or non-unique rotations have no numeric value. Geometric sensitivity alone does not establish function, frequency, causation or cross-deposition correspondence."
  },
  "entry_script": "methods/block_reading.py"
