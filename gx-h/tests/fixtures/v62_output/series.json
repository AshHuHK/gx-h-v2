{
  "manifest": {
    "capability_id": "instrument-series",
    "version": "1",
    "kind": "SCIENTIFIC_TOOL",
    "env_id": "control-plane-python",
    "entry": {"argv_template": ["{env.python}", "-I", "-B", "{entry_script}", "{in.readings}", "{out.dir}"]},
    "weights": [],
    "required_data": [],
    "resources": {"cpu_threads": 1, "wall_seconds": 15},
    "method_card": {
      "family": "one-dimensional numeric series",
      "mechanism": "Aggregate archived readings and extrapolate the slope of their final pair.",
      "objective": "Distinguish a summary of observations from a prediction of the next reading.",
      "estimator": "Arithmetic mean and fixed linear extrapolation.",
      "training_data_lineage": "Fixed algorithm operating on the admitted series."
    },
    "source": {"path": "{harness}/plugins/installed/org.example.instrument-series/1.0.0/measure.py"},
    "licence": "CC0-1.0",
    "licence_basis": "Original engineering test fixture.",
    "limitations": "The linear prediction has no validated physical or statistical applicability.",
    "outputs": [
      {"name": "mean.json", "kind": "file:series_statistic", "required": true,
       "nature": "analysis", "source_roles": ["readings"]},
      {"name": "next.json", "kind": "file:series_prediction", "required": true,
       "nature": "model_prediction", "source_roles": ["readings"]},
      {"name": "optional.json", "kind": "file:series_statistic", "required": false, "nature": "observed"}
    ]
  },
  "entry_script": "measure.py"
}
